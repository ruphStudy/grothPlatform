# APP
NODE_ENV=development
PORT=3000
APP_VERSION=local
GIT_SHA=local
BACKEND_PUBLIC_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
LEGAL_ENTITY_NAME=replace-with-legal-entity-name
LEGAL_CONTACT_EMAIL=replace-with-legal-contact-email
SUPPORT_EMAIL=replace-with-support-email
TERMS_VERSION=2026-09
PRIVACY_VERSION=2026-09

# AUTH
JWT_SECRET=replace-with-secret

# DATABASE
MONGODB_URI=mongodb://localhost:27017/gip_dev
AUTO_INDEX=true

# FRONTEND
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_NAME=Growth Intelligence Platform
VITE_ERROR_MONITORING_DSN=

# CORS / SECURITY
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
API_BODY_LIMIT=1mb
SLOW_REQUEST_MS=2000

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4o-mini

# EMAIL / SOCIAL / CMS
EMAIL_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SOCIAL_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
CMS_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# PAYMENT / BILLING
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
BILLING_TRIAL_DAYS=0

# STORAGE
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./storage
STORAGE_BUCKET=replace-with-bucket
STORAGE_REGION=replace-with-region
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret
STORAGE_PUBLIC_BASE_URL=
STORAGE_SIGNING_SECRET=replace-with-storage-signing-secret
STORAGE_MAX_OBJECT_BYTES=10485760

# MONITORING
ERROR_MONITORING_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# RATE_LIMIT
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=240
RATE_LIMIT_ANALYTICS_WINDOW_MS=60000
RATE_LIMIT_ANALYTICS_MAX=2000
